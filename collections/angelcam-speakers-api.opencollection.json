        {
          "info": {
            "name": "Start audio playback",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.angelcam.com/v1/speakers/:speaker_id/play/",
            "params": [
              {
                "name": "speaker_id",
                "value": "1",
                "type": "path",
