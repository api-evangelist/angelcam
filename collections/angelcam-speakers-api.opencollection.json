        },
        {
          "info": {
            "name": "Test speaker connection",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.angelcam.com/v1/speakers/:speaker_id/test/",
            "params": [
              {
                "name": "speaker_id",
                "value": "1",
                "type": "path",
                "description": "Speaker ID"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://my.angelcam.com/oauth/authorize/",
              "accessTokenUrl": "https://my.angelcam.com/oauth/token/",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "On success, the endpoint returns HTTP 204; otherwise, HTTP 400 with a detail about the connection issue is returned.\n\n_Note that this is just a connectivity test. Successful connectivity test does not mean that the speaker itself works (i.e. that it's able to play audio)._\n"
        }
