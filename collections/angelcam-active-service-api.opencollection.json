{
  "opencollection": "1.0.0",
  "info": {
    "name": "Angelcam Active Service API",
    "version": "2026.06.11"
  },
  "items": [
    {
      "info": {
        "name": "active-service",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve list of my services",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.angelcam.com/v1/billing/active-services/",
            "params": [
              {
                "name": "type",
                "value": "",
                "type": "query",
                "description": "Filtering by service type"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://my.angelcam.com/oauth/authorize/",
              "accessTokenUrl": "https://my.angelcam.com/oauth/token/",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Retrieve list of my services"
        },
        {
          "info": {
            "name": "Activate new service",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.angelcam.com/v1/billing/active-services/",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://my.angelcam.com/oauth/authorize/",
              "accessTokenUrl": "https://my.angelcam.com/oauth/token/",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Purchase and activate a new service for your account. After activation, [assign the service to a camera](#operation/my-service-usage-update) using the returned active service `id`.\n"
        },
        {
          "info": {
            "name": "Retrieve my service detail",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.angelcam.com/v1/billing/active-services/:active_service_id/",
            "params": [
              {
                "name": "active_service_id",
                "value": "3",
                "type": "path",
                "description": "Active service ID"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://my.angelcam.com/oauth/authorize/",
              "accessTokenUrl": "https://my.angelcam.com/oauth/token/",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Retrieve my service detail"
        },
        {
          "info": {
            "name": "Change service",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.angelcam.com/v1/billing/active-services/:active_service_id/",
            "params": [
              {
                "name": "active_service_id",
                "value": "3",
                "type": "path",
                "description": "Active service ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://my.angelcam.com/oauth/authorize/",
              "accessTokenUrl": "https://my.angelcam.com/oauth/token/",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Change service"
        },
        {
          "info": {
            "name": "Cancel active service",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.angelcam.com/v1/billing/active-services/:active_service_id/",
            "params": [
              {
                "name": "active_service_id",
                "value": "3",
                "type": "path",
                "description": "Active service ID"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://my.angelcam.com/oauth/authorize/",
              "accessTokenUrl": "https://my.angelcam.com/oauth/token/",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Cancel active service"
        },
        {
          "info": {
            "name": "Retrieve my service usage detail",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.angelcam.com/v1/billing/active-services/:active_service_id/usage/",
            "params": [
              {
                "name": "active_service_id",
                "value": "3",
                "type": "path",
                "description": "Active service ID"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://my.angelcam.com/oauth/authorize/",
              "accessTokenUrl": "https://my.angelcam.com/oauth/token/",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Retrieve my service usage detail"
        },
        {
          "info": {
            "name": "Change service usage",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.angelcam.com/v1/billing/active-services/:active_service_id/usage/",
            "params": [
              {
                "name": "active_service_id",
                "value": "3",
                "type": "path",
                "description": "Active service ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://my.angelcam.com/oauth/authorize/",
              "accessTokenUrl": "https://my.angelcam.com/oauth/token/",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Assign this active service to a camera, or unassign it by setting `camera_id` to `null`. A service must be assigned to a camera before it takes effect on that camera.\n"
        }
      ]
    }
  ],
  "bundled": true
}