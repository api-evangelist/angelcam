{
  "opencollection": "1.0.0",
  "info": {
    "name": "Angelcam active-service Rts Messages API",
    "version": "2026.06.11"
  },
  "items": [
    {
      "info": {
        "name": "rts_messages",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve messages",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.angelcam.com/v1/rts/messages/",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Limit result set. Example: `1`."
              },
              {
                "name": "next",
                "value": "",
                "type": "query",
                "description": "Cursor for the next page, taken from `next` field of a previous response."
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://my.angelcam.com/oauth/authorize/",
              "accessTokenUrl": "https://my.angelcam.com/oauth/token/",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Retrieves list of user messages"
        },
        {
          "info": {
            "name": "Set all messages as read",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.angelcam.com/v1/rts/messages/set-all-read/",
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://my.angelcam.com/oauth/authorize/",
              "accessTokenUrl": "https://my.angelcam.com/oauth/token/",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Set all messages as read"
        },
        {
          "info": {
            "name": "Retrieve unread messages count",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.angelcam.com/v1/rts/messages/unread-count/",
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://my.angelcam.com/oauth/authorize/",
              "accessTokenUrl": "https://my.angelcam.com/oauth/token/",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Retrieve unread messages count"
        },
        {
          "info": {
            "name": "Retrieve message detail",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.angelcam.com/v1/rts/messages/:message_id/",
            "params": [
              {
                "name": "message_id",
                "value": "3",
                "type": "path",
                "description": "Message ID"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://my.angelcam.com/oauth/authorize/",
              "accessTokenUrl": "https://my.angelcam.com/oauth/token/",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Retrieve message detail"
        },
        {
          "info": {
            "name": "Update message",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.angelcam.com/v1/rts/messages/:message_id/",
            "params": [
              {
                "name": "message_id",
                "value": "3",
                "type": "path",
                "description": "Message ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://my.angelcam.com/oauth/authorize/",
              "accessTokenUrl": "https://my.angelcam.com/oauth/token/",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Update messages"
        }
      ]
