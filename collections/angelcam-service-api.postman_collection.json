  "item": [
    {
      "id": "1bd8c9ae-7874-43f7-b585-a8d9347914c9",
      "name": "service",
      "description": {
        "content": "A catalog of services available for purchase. Use these endpoints to discover service `code` values before activating a service via the [My services](#tag/active-service) endpoints.\nServices fall into two categories:\n* **Account plan** — your overall subscription level. * **Camera services** — features you enable on individual cameras. The two main camera services are **Cloud Recording** and **Broadcasting**. Activating a camera service creates an active service instance that you then [assign to a specific camera](#operation/my-service-usage-update).\n",
        "type": "text/plain"
      },
