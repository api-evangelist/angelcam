            "params": [
              {
                "name": "type",
                "value": "",
                "type": "query",
                "description": "Filtering by service type"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://my.angelcam.com/oauth/authorize/",
              "accessTokenUrl": "https://my.angelcam.com/oauth/token/",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Retrieve list of available services"
        }
      ]
    }
  ],
  "bundled": true
