{
  "opencollection": "1.0.0",
  "info": {
    "name": "Angelcam active-service Incidents API",
    "version": "2026.06.11"
  },
  "items": [
    {
      "info": {
        "name": "incidents",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve incidents",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.angelcam.com/v1/rts/incidents/",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Limit result set. Example: `1`."
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Return results starting at `offset`. Example: `10`."
              },
              {
                "name": "start",
                "value": "",
                "type": "query",
                "description": "Example: `2017-03-07T14:00:00Z`."
              },
              {
                "name": "end",
                "value": "",
                "type": "query",
                "description": "Example: `2017-03-07T16:00:00Z`."
              },
              {
                "name": "ordering",
                "value": "",
                "type": "query",
                "description": "Orderign of results, based on `created_at` field. Default: desc"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://my.angelcam.com/oauth/authorize/",
              "accessTokenUrl": "https://my.angelcam.com/oauth/token/",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Retrieves list of user incidents"
        },
        {
          "info": {
            "name": "Retrieve incident detail",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.angelcam.com/v1/rts/incidents/:incident_id/",
            "params": [
              {
                "name": "incident_id",
                "value": "3",
                "type": "path",
                "description": "Incident ID"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://my.angelcam.com/oauth/authorize/",
              "accessTokenUrl": "https://my.angelcam.com/oauth/token/",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Retrieve incident detail"
        }
      ]
    }
  ],
  "bundled": true
}