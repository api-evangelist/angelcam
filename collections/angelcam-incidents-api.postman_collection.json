  "item": [
    {
      "id": "0c8a7e35-9c7c-408b-82ed-601fb1d4c11a",
      "name": "incidents",
      "description": {
        "content": "Endpoints for managing Real Time Security (RTS) incidents.\nAn incident is a security event that has been detected and may require attention. Incidents are created automatically when sensor events or camera status changes match an active [notification rule](#tag/rts_notification_rules).\nIncidents go through the following states:\n* **Open** — the incident has been created and not yet reviewed. * **Verified** — acknowledged as a genuine security event (`verified_at` is set). * **Closed** — the incident has been resolved (`closed_at` is set). An incident can be closed without being verified first (e.g. a false alarm).\n",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "52f0da8f-7de5-4157-b476-d1fd14313dfe",
          "name": "Retrieve incidents",
          "request": {
            "name": "Retrieve incidents",
            "description": {
              "content": "Retrieves list of user incidents",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "rts",
                "incidents",
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>",
                  "description": "Limit result set. Example: `1`."
                },
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "<integer>",
                  "description": "Return results starting at `offset`. Example: `10`."
                },
                {
                  "disabled": false,
                  "key": "start",
                  "value": "<dateTime>",
                  "description": "Example: `2017-03-07T14:00:00Z`."
                },
                {
                  "disabled": false,
                  "key": "end",
                  "value": "<dateTime>",
                  "description": "Example: `2017-03-07T16:00:00Z`."
                },
                {
                  "disabled": false,
                  "key": "ordering",
                  "value": "<string>",
                  "description": "Orderign of results, based on `created_at` field. Default: desc"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "oauth2",
              "oauth2": [
                {
                  "key": "scope",
                  "value": "user_access user_delete camera_access camera_create camera_manage camera_delete camera_guest_access camera_guest_manage public_cameras_access arrow_client_access arrow_client_manage event_access recording_access recording_start_stop recording_clips_access recording_clips_create recording_clips_share sensor_access sensor_manage broadcasting_access broadcasting_start_stop client_access client_create client_manage streams_detect sites_access sites_manage services_access trials_access trials_activate active_services_access active_services_manage orders_access messages_access messages_manage incidents_access space_access space_permissions_access"
                },
                {
                  "key": "accessTokenUrl",
                  "value": "https://my.angelcam.com/oauth/token/"
                },
                {
                  "key": "authUrl",
                  "value": "https://my.angelcam.com/oauth/authorize/"
                },
                {
                  "key": "grant_type",
                  "value": "authorization_code"
                }
              ]
            }
          },
