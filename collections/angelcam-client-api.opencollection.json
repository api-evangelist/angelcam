{
  "opencollection": "1.0.0",
  "info": {
    "name": "Angelcam active-service Client API",
    "version": "2026.06.11"
  },
  "items": [
    {
      "info": {
        "name": "client",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve clients list",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.angelcam.com/v1/clients/",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Limit result set. Example: `1`."
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Return results starting at `offset`. Example: `10`."
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://my.angelcam.com/oauth/authorize/",
              "accessTokenUrl": "https://my.angelcam.com/oauth/token/",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Retrieve clients list"
        },
        {
          "info": {
            "name": "Creates new client account",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.angelcam.com/v1/clients/",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://my.angelcam.com/oauth/authorize/",
              "accessTokenUrl": "https://my.angelcam.com/oauth/token/",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Creates a new client account. After successful creation client receives an email with link for account activation.\n"
        },
        {
          "info": {
            "name": "Retrieve client",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.angelcam.com/v1/clients/:client_id/",
            "params": [
              {
                "name": "client_id",
                "value": "6",
                "type": "path",
                "description": "Client ID"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://my.angelcam.com/oauth/authorize/",
              "accessTokenUrl": "https://my.angelcam.com/oauth/token/",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Retrieve client"
        },
        {
          "info": {
            "name": "Update client account",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.angelcam.com/v1/clients/:client_id/",
            "params": [
              {
                "name": "client_id",
                "value": "6",
                "type": "path",
                "description": "Client ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://my.angelcam.com/oauth/authorize/",
              "accessTokenUrl": "https://my.angelcam.com/oauth/token/",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Update client account"
        },
        {
          "info": {
            "name": "Resend invitation email",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.angelcam.com/v1/clients/:client_id/invite/",
            "params": [
              {
                "name": "client_id",
                "value": "6",
                "type": "path",
                "description": "Client ID"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://my.angelcam.com/oauth/authorize/",
              "accessTokenUrl": "https://my.angelcam.com/oauth/token/",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "For resending an invitation email. This is useful in case when client does not receive the first invitation email,\n so client get new chance to activate their account and set a password.\n"
        }
      ]
    }
  ],
  "bundled": true
}