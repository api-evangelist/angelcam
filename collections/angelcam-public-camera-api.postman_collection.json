  "item": [
    {
      "id": "7d67e21a-52e7-4594-ad7f-4bc7b5fa66bd",
      "name": "public-camera",
      "description": {
        "content": "Endpoints for browsing cameras that are publicly accessible. A camera appears here if it has the Broadcasting service active and has been marked as public — either because it uses free public broadcasting, or because the camera owner has explicitly enabled public access.\n> **Access restricted:** These endpoints are available only to partners who have arranged access with Angelcam. Please contact [support](https://www.angelcam.com/support/) if you are interested in using them.\n",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "a51e67e4-c36f-4a74-82f7-d07debccc2c6",
          "name": "Retrieve public camera list",
          "request": {
            "name": "Retrieve public camera list",
            "description": {},
            "url": {
              "path": [
                "public-cameras",
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>",
                  "description": "Limit result set. Example: `1`."
                },
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "<integer>",
                  "description": "Return results starting at `offset`. Example: `10`."
                },
                {
                  "disabled": false,
                  "key": "online",
                  "value": "<boolean>",
                  "description": "`1` for filtering only cameras that are online. `0` for filtering only cameras that are offline. Be aware that you cannot fully rely on this filtering. The camera status is checked every 10 minutes. Therefore the real status of camera can differ from API status."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "oauth2",
              "oauth2": [
                {
                  "key": "scope",
                  "value": "user_access user_delete camera_access camera_create camera_manage camera_delete camera_guest_access camera_guest_manage public_cameras_access arrow_client_access arrow_client_manage event_access recording_access recording_start_stop recording_clips_access recording_clips_create recording_clips_share sensor_access sensor_manage broadcasting_access broadcasting_start_stop client_access client_create client_manage streams_detect sites_access sites_manage services_access trials_access trials_activate active_services_access active_services_manage orders_access messages_access messages_manage incidents_access space_access space_permissions_access"
                },
                {
                  "key": "accessTokenUrl",
                  "value": "https://my.angelcam.com/oauth/token/"
                },
                {
                  "key": "authUrl",
                  "value": "https://my.angelcam.com/oauth/authorize/"
                },
                {
                  "key": "grant_type",
                  "value": "authorization_code"
                }
              ]
            }
          },
