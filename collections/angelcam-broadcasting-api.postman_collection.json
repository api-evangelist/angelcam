  "item": [
    {
      "id": "d7076197-3898-4d1b-9cae-7cf6ae440e8e",
      "name": "broadcasting",
      "description": {
        "content": "Endpoints for managing broadcasting settings and retrieving broadcasting streams. If a camera doesn't have the Broadcasting service activated, all camera broadcasting endpoints will return HTTP 404.\n\nThe broadcasting service can be used whenever you need more concurrent stream consumers. It does not necessarily mean that the stream from your camera has to be public.\n",
        "type": "text/plain"
      },
