  "item": [
    {
      "id": "5d9ddf01-9eb1-43d4-b6c9-97ae91cbd16a",
      "name": "space",
      "description": {
        "content": "A **space** is the organisational unit in Angelcam — it owns all resources: cameras, locations, recordings, services, and billing. Every API request operates within a space context — by default the user's default space, or a specific space selected via the `X-Space-Id` header.\nSee the [Key concepts guide](/guides/key-concepts/) for details on space context and permissions.\n",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "c8146f7d-7e35-47fd-ad1e-1fa5840fe439",
          "name": "List spaces",
          "request": {
            "name": "List spaces",
            "description": {
              "content": "Returns all spaces the authenticated user belongs to. Use the `is_default` flag to identify the user's default space. To operate within a specific space, pass the `X-Space-Id` request header with the desired space ID.\n",
              "type": "text/plain"
            },
