      "name": "camera-stream-detection",
      "description": {
        "content": "Using these endpoints you can verify if there are camera streams available on specified network address. Detection is asynchronous. For this reason there is one endpoint for initializing stream detection and one for retrieving result of detection.",
        "type": "text/plain"
      },
