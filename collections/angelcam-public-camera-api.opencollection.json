{
  "opencollection": "1.0.0",
  "info": {
    "name": "Angelcam active-service Public Camera API",
    "version": "2026.06.11"
  },
  "items": [
    {
      "info": {
        "name": "public-camera",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve public camera list",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.angelcam.com/v1/public-cameras/",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Limit result set. Example: `1`."
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Return results starting at `offset`. Example: `10`."
              },
              {
                "name": "online",
                "value": "",
                "type": "query",
                "description": "`1` for filtering only cameras that are online. `0` for filtering only cameras that are offline. Be aware that you cannot fully rely on this filtering. The camera status is checked every 10 minutes. Therefore the real status of camera can differ from API status."
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://my.angelcam.com/oauth/authorize/",
              "accessTokenUrl": "https://my.angelcam.com/oauth/token/",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Retrieve public camera list"
        },
        {
          "info": {
            "name": "Retrieve public camera",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.angelcam.com/v1/public-cameras/:camera_id/",
            "params": [
              {
                "name": "camera_id",
                "value": "21",
                "type": "path",
                "description": "Camera ID"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://my.angelcam.com/oauth/authorize/",
              "accessTokenUrl": "https://my.angelcam.com/oauth/token/",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Retrieve public camera"
        }
      ]
    }
  ],
  "bundled": true
}